# === 0. 프로젝트 최상단 변수: 민감 값은 기입하지 말고 별도 Secret/환경으로 관리 ===
# 이 파일을 프로젝트 루트 `.env`로 복사하고 사용자 환경에 맞춰 수정합니다.
PROJECT_NAME=memonest
PROJECT_ENV=development
APP_BASE_URL=http://127.0.0.1:5173
API_BASE_URL=http://127.0.0.1:8080
API_BIND_ADDRESS=127.0.0.1:8080
DEFAULT_LOCALE=ko
DEFAULT_NOTE_FORMAT=md
MAX_FOLDER_DEPTH=2
MAX_UNDO_STEPS=250
IDLE_TIMEOUT_SECONDS=60
# Git 주소가 정해질 때만 입력합니다. 인증키·토큰 저장 금지.
GIT_REMOTE_URL=
GIT_DEFAULT_BRANCH=main
# Helm/Kubernetes는 기존 kubectl 인증(현재 context)을 사용하며 비밀정보를 복제하지 않습니다.
KUBE_CONTEXT=
KUBE_NAMESPACE=memonest
HELM_RELEASE=memonest-api
K8S_IMAGE_REPOSITORY=
K8S_IMAGE_TAG=0.1.0
K8S_STORAGE_CLASS=
# 선택: 사용자의 S3 호환 서버 및 OIDC 발급자 (미구현, 미래 통합용)
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
# 관리자 지정 정책 값(실제 서버 검증 로직은 구현 전)
MAX_ACCOUNTS=999
FREE_STORAGE_MB=100
PLUS_STORAGE_MB=1024
PRO_STORAGE_MB=10240

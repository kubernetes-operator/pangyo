{
  "openapi": "3.1.0",
  "info": {
    "title": "MemoNest API",
    "version": "0.1.0",
    "description": "MemoNest 서버 API 계약의 단일 원본 (ADR-0002). x-memonest-status: implemented = 동작, planned = 설계만 존재(501). 계약 테스트: crates/server/tests/api.rs. 설계 설명: docs/05_SYNC_API.md"
  },
  "paths": {
    "/healthz": {
      "get": {
        "summary": "Liveness",
        "x-memonest-status": "implemented",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "summary": "Readiness (외부 저장소 미사용)",
        "x-memonest-status": "implemented",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/info": {
      "get": {
        "summary": "서버 버전과 기능 활성 여부",
        "x-memonest-status": "implemented",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Info"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/pairing/start": {
      "post": {
        "summary": "장비 등록 일회용 코드/QR",
        "x-memonest-status": "planned",
        "x-required-scope": "logged-in user",
        "responses": {
          "501": {
            "description": "아직 구현되지 않음 (v0.1). 인증·동기화가 있는 것처럼 보이는 가짜 응답을 내지 않습니다.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotImplemented"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/pairing/finish": {
      "post": {
        "summary": "일회용 코드 교환, device token 발급",
        "x-memonest-status": "planned",
        "x-required-scope": "valid code",
        "responses": {
          "501": {
            "description": "아직 구현되지 않음 (v0.1). 인증·동기화가 있는 것처럼 보이는 가짜 응답을 내지 않습니다.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotImplemented"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/notes": {
      "get": {
        "summary": "소유자 노트 변경 목록 (cursor)",
        "x-memonest-status": "planned",
        "x-required-scope": "notes:read",
        "responses": {
          "501": {
            "description": "아직 구현되지 않음 (v0.1). 인증·동기화가 있는 것처럼 보이는 가짜 응답을 내지 않습니다.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotImplemented"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/notes/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "get": {
        "summary": "단일 노트 읽기",
        "x-memonest-status": "planned",
        "x-required-scope": "notes:read",
        "responses": {
          "501": {
            "description": "아직 구현되지 않음 (v0.1). 인증·동기화가 있는 것처럼 보이는 가짜 응답을 내지 않습니다.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotImplemented"
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "버전 조건으로 노트 변경",
        "x-memonest-status": "planned",
        "x-required-scope": "notes:write",
        "responses": {
          "501": {
            "description": "아직 구현되지 않음 (v0.1). 인증·동기화가 있는 것처럼 보이는 가짜 응답을 내지 않습니다.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotImplemented"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/notes/{id}/similar": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "get": {
        "summary": "연관 문서",
        "x-memonest-status": "planned",
        "x-required-scope": "notes:read",
        "responses": {
          "501": {
            "description": "아직 구현되지 않음 (v0.1). 인증·동기화가 있는 것처럼 보이는 가짜 응답을 내지 않습니다.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotImplemented"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/sync/commit": {
      "post": {
        "summary": "idempotency key와 version을 포함한 배치",
        "x-memonest-status": "planned",
        "x-required-scope": "notes:write",
        "responses": {
          "501": {
            "description": "아직 구현되지 않음 (v0.1). 인증·동기화가 있는 것처럼 보이는 가짜 응답을 내지 않습니다.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotImplemented"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/account/quota": {
      "get": {
        "summary": "본인 사용량 및 요금제",
        "x-memonest-status": "planned",
        "x-required-scope": "account:read",
        "responses": {
          "501": {
            "description": "아직 구현되지 않음 (v0.1). 인증·동기화가 있는 것처럼 보이는 가짜 응답을 내지 않습니다.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotImplemented"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/integrations/tokens": {
      "post": {
        "summary": "n8n 전용 범위/만료 토큰 발급",
        "x-memonest-status": "planned",
        "x-required-scope": "owner",
        "responses": {
          "501": {
            "description": "아직 구현되지 않음 (v0.1). 인증·동기화가 있는 것처럼 보이는 가짜 응답을 내지 않습니다.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotImplemented"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Status": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "const": "ok"
          }
        }
      },
      "Readiness": {
        "type": "object",
        "required": [
          "status",
          "note"
        ],
        "properties": {
          "status": {
            "const": "ok"
          },
          "note": {
            "type": "string",
            "examples": [
              "sync_not_ready"
            ]
          }
        }
      },
      "Info": {
        "type": "object",
        "required": [
          "version",
          "authEnabled",
          "syncEnabled",
          "warning"
        ],
        "properties": {
          "version": {
            "type": "string"
          },
          "authEnabled": {
            "type": "boolean"
          },
          "syncEnabled": {
            "type": "boolean"
          },
          "warning": {
            "type": "string"
          }
        }
      },
      "NotImplemented": {
        "type": "object",
        "required": [
          "error",
          "message"
        ],
        "properties": {
          "error": {
            "const": "not_implemented"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "Note": {
        "$ref": "schemas/note.schema.json"
      }
    }
  }
}

  "components": {
    "schemas": {
      "Status": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "const": "ok"
          }
        }
      },
      "Readiness": {
        "type": "object",
        "required": [
          "status",
          "note"
        ],
        "properties": {
          "status": {
            "const": "ok"
          },
          "note": {
            "type": "string",
            "examples": [
              "sync_not_ready"
            ]
          },
          "database": {
            "enum": [
              "ok",
              "error",
              "not_configured"
            ]
          }
        }
      },
      "Info": {
        "type": "object",
        "required": [
          "version",
          "authEnabled",
          "syncEnabled",
          "warning"
        ],
        "properties": {
          "version": {
            "type": "string"
          },
          "authEnabled": {
            "type": "boolean",
            "description": "DATABASE_URL 설정 시 true (계정 기능)"
          },
          "syncEnabled": {
            "type": "boolean"
          },
          "warning": {
            "type": "string"
          }
        }
      },
      "NotImplemented": {
        "type": "object",
        "required": [
          "error",
          "message"
        ],
        "properties": {
          "error": {
            "const": "not_implemented"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "Note": {
        "$ref": "schemas/note.schema.json"
      },
      "Error": {
        "type": "object",
        "required": [
          "error",
          "message"
        ],
        "properties": {
          "error": {
            "type": "string",
            "examples": [
              "invalid_credentials",
              "email_taken",
              "csrf",
              "rate_limited",
              "account_limit_reached",
              "database_not_configured"
            ]
          },
          "message": {
            "type": "string"
          }
        }
      },
      "Providers": {
        "type": "object",
        "required": [
          "local",
          "google",
          "registration"
        ],
        "properties": {
          "local": {
            "type": "boolean"
          },
          "google": {
            "type": "boolean"
          },
          "registration": {
            "enum": [
              "open",
              "closed"
            ]
          }
        }
      },
      "RegisterRequest": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 10,
            "maxLength": 256
          },
          "displayName": {
            "type": "string",
            "maxLength": 80
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "Account": {
        "type": "object",
        "required": [
          "id",
          "email",
          "displayName",
          "authProvider",
          "tier",
          "quotaBytes",
          "usedBytes",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": [
              "string",
              "null"
            ]
          },
          "displayName": {
            "type": "string"
          },
          "authProvider": {
            "enum": [
              "local",
              "google"
            ]
          },
          "tier": {
            "enum": [
              "free",
              "plus",
              "pro"
            ]
          },
          "quotaBytes": {
            "type": "integer"
          },
          "usedBytes": {
            "type": "integer"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Quota": {
        "type": "object",
        "required": [
          "tier",
          "quotaBytes",
          "usedBytes"
        ],
        "properties": {
          "tier": {
            "type": "string"
          },
          "quotaBytes": {
            "type": "integer"
          },
          "usedBytes": {
            "type": "integer"
          }
        }
      },
      "PairingStart": {
        "type": "object",
        "required": [
          "code",
          "expiresAt"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-HJ-NP-Z2-9]{8}$"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "PairingFinishRequest": {
        "type": "object",
        "required": [
          "code",
          "deviceName",
          "platform"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "deviceName": {
            "type": "string",
            "maxLength": 80
          },
          "platform": {
            "type": "string",
            "examples": [
              "windows",
              "linux",
              "macos",
              "android",
              "ios",
              "freebsd",
              "n8n"
            ]
          }
        }
      },
      "PairingFinish": {
        "type": "object",
        "required": [
          "deviceId",
          "token"
        ],
        "properties": {
          "deviceId": {
            "type": "string",
            "format": "uuid"
          },
          "token": {
            "type": "string",
            "description": "Authorization: Bearer 로 사용. OS 보안 저장소에 보관"
          }
        }
      },
      "Device": {
        "type": "object",
        "required": [
          "id",
          "name",
          "platform",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "platform": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "lastSeenAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "revokedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      }
    },
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "memonest_session",
        "description": "웹 로그인 세션 (HttpOnly, SameSite=Strict)"
      },
      "device": {
        "type": "http",
        "scheme": "bearer",
        "description": "장비 등록으로 받은 토큰"
      }
    },
    "parameters": {
      "CsrfHeader": {
        "name": "X-MemoNest-Request",
        "in": "header",
        "required": true,
        "schema": {
          "const": "1"
        },
        "description": "상태 변경 요청 필수 (CSRF 방지)"
      }
    }
  }
}
